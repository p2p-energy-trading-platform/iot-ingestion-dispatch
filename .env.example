SERVICE_NAME=iot-ingestion-dispatch
SERVICE_ENV=development
LOG_LEVEL=info

KAFKA_BROKER=localhost:9092
KAFKA_CONSUMER_GROUP=iot-ingestion
KAFKA_METER_TOPIC=iot.meter-readings
KAFKA_HEARTBEAT_TOPIC=iot.heartbeats

POSTGRES_URL=postgres://iot_service_user:your_iot_service_password@localhost:5433/gridx_timescaledb?sslmode=disable

DOCKER_POSTGRES_URL=postgres://iot_service_user:your_iot_service_password@timescaledb:5432/gridx_timescaledb?sslmode=disable

REDIS_ADDRESS=localhost:6379

GRPC_ADDRESS=:50051
HEALTH_ADDRESS=:8080

INGESTION_RETRY_MAX_TRIES=3
INGESTION_RETRY_INITIAL_INTERVAL=100ms
INGESTION_RETRY_MAX_INTERVAL=2s

INGESTION_MAX_RECORD_BYTES=65536
INGESTION_MAX_CONCURRENT_HANDLERS=16
# Reject records whose Kafka key names a different house than the payload.
# Accepts the bare house_id or the MQTT topic key the connector produces
# (gridx/{grid_id}/{house_id}/meter|heartbeat), verified against the live connector.
INGESTION_ENFORCE_HOUSE_KEY=false

# Redis acknowledgement policy when TimescaleDB succeeded but Redis failed:
#   required     - leave the offset uncommitted until Redis succeeds
#   async-repair - acknowledge, count cache_degraded, repair via redis-rebuild
REDIS_ACK_POLICY=required
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=2s
REDIS_WRITE_TIMEOUT=2s
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=2
REDIS_MAX_RETRIES=2
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=true

POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
POSTGRES_STATEMENT_TIMEOUT=15s

# KAFKA_TLS=true
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USER=
# KAFKA_SASL_PASSWORD=
KAFKA_SESSION_TIMEOUT=45s
KAFKA_HEARTBEAT_INTERVAL=3s

SHUTDOWN_TIMEOUT=30s
ADMISSION_REFRESH_INTERVAL=120s

# Prometheus /metrics listener (separate from the health port). Empty disables it.
METRICS_ADDRESS=:9090

# Tracing is off unless an OTLP/gRPC collector is configured.
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true